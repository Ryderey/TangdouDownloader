[Unit]
Description=Tangdou MP3 Extractor Worker
After=network.target redis.service

[Service]
Type=simple
WorkingDirectory=/home/ryl/script/tangdou-web

# 环境变量
Environment="REDIS_HOST=localhost"
Environment="REDIS_PORT=6379"
Environment="REDIS_DB=0"
Environment="PYTHONUNBUFFERED=1"

# 使用项目内 Python Worker，避免 RQ CLI 参数版本差异
ExecStart=/home/ryl/script/tangdou-web/.venv/bin/python /home/ryl/script/tangdou-web/scripts/rq_worker.py

Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
