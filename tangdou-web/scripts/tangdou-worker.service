[Unit]
Description=Tangdou MP3 Extractor Worker
After=network.target redis.service

[Service]
Type=simple
WorkingDirectory=/home/ryl/script/tangdou-web

# 环境变量
Environment="REDIS_HOST=localhost"
Environment="REDIS_PORT=6379"
Environment="REDIS_DB=0"
Environment="PYTHONUNBUFFERED=1"

# 使用虚拟环境中的rqworker可执行文件（基本参数）
ExecStart=/home/ryl/script/tangdou-web/.venv/bin/rqworker --name tangdou-worker --url redis://localhost:6379/0 --with-scheduler tangdou

Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target